{
  "name": "coding-session-history-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only MCP retrieval of local Codex session history",
  "bin": {
    "coding-session-history": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && tsx --test test/*.test.ts",
    "check": "tsc -p tsconfig.test.json && npm test",
    "benchmark": "tsx scripts/benchmark.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  },
  "files": [
    "dist/*.js",
    "docs/*.md"
  ],
  "license": "MIT"
}
